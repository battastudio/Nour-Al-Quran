{"meta":{"n":70,"name":"المعارج","nameLatin":"Al-Ma'arij","ayahCount":44,"revelation":"meccan","bismillah":true},"ayahs":[{"s":70,"a":1,"t":" سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ","p":568,"j":29,"h":57,"r":504},{"s":70,"a":2,"t":"لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ","p":568,"j":29,"h":57,"r":504},{"s":70,"a":3,"t":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","p":568,"j":29,"h":57,"r":504},{"s":70,"a":4,"t":"تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ","p":568,"j":29,"h":57,"r":504},{"s":70,"a":5,"t":"فَٱصْبِرْ صَبْرًا جَمِيلًا","p":568,"j":29,"h":57,"r":504},{"s":70,"a":6,"t":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا","p":568,"j":29,"h":57,"r":504},{"s":70,"a":7,"t":"وَنَرَىٰهُ قَرِيبًا","p":568,"j":29,"h":57,"r":504},{"s":70,"a":8,"t":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","p":568,"j":29,"h":57,"r":504},{"s":70,"a":9,"t":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","p":568,"j":29,"h":57,"r":504},{"s":70,"a":10,"t":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا","p":568,"j":29,"h":57,"r":504},{"s":70,"a":11,"t":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":12,"t":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":13,"t":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":14,"t":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":15,"t":"كَلَّآ ۖ إِنَّهَا لَظَىٰ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":16,"t":"نَزَّاعَةً لِّلشَّوَىٰ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":17,"t":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":18,"t":"وَجَمَعَ فَأَوْعَىٰٓ","p":569,"j":29,"h":57,"r":504},{"s":70,"a":19,"t":"۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا","p":569,"j":29,"h":57,"r":504},{"s":70,"a":20,"t":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","p":569,"j":29,"h":57,"r":504},{"s":70,"a":21,"t":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","p":569,"j":29,"h":57,"r":504},{"s":